# No live defaults. Replace host, database and placeholders deliberately.
# Auth modes are INDEPENDENT. No implicit USE_PASSWORDLESS or localhost bypass.
MONGO_AUTH_MODE=native
MONGO_HOST=<cluster>.global.mongocluster.cosmos.azure.com
MONGO_PORT=10260
MONGO_CONNECTION_STRING=mongodb://<percent-encoded-user>:<percent-encoded-password>@<cluster>.global.mongocluster.cosmos.azure.com:10260/?tls=true&authMechanism=SCRAM-SHA-256&authSource=admin&directConnection=true&retryWrites=false
# Entra: set MONGO_AUTH_MODE=entra and UNSET MONGO_CONNECTION_STRING.
# MONGO_OIDC_USERNAME=<optional-object-id>
MONGO_DATABASE=agent_disposable_<unique_run_id_at_least_8_chars>
MONGO_COLLECTION=hotels
# Write and cleanup require EXACT database.collection, not a boolean.
# ALLOW_WRITES=agent_disposable_<unique_run_id_at_least_8_chars>.hotels
# CONFIRM_CLEANUP=agent_disposable_<unique_run_id_at_least_8_chars>.hotels

AZURE_OPENAI_AUTH_MODE=api-key
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<supply-privately>
# Entra: set AZURE_OPENAI_AUTH_MODE=entra and UNSET AZURE_OPENAI_API_KEY.
AZURE_OPENAI_EMBEDDING_MODEL=<embedding-deployment>
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-10-21
AZURE_OPENAI_PLANNER_MODEL=<planner-deployment>
AZURE_OPENAI_PLANNER_API_VERSION=2024-10-21
AZURE_OPENAI_SYNTH_MODEL=<synthesizer-deployment>
AZURE_OPENAI_SYNTH_API_VERSION=2024-10-21
EMBEDDING_DIMENSIONS=1536
DATA_FILE_WITHOUT_VECTORS=data/Hotels.json
NEAREST_NEIGHBORS=3
QUERY=A quiet hotel near walking trails

# Paid requests are disabled until this EXACT consent is supplied:
# ALLOW_PAID_MODELS=I_ACCEPT_MODEL_CHARGES
MAX_MODEL_REQUESTS=12
MAX_MODEL_INPUT_CHARS=60000
MAX_OUTPUT_TOKENS=512
MODEL_TIMEOUT_MS=20000
RUN_TIMEOUT_MS=90000
# Live gate additionally requires exact target + both write/cleanup consents:
# LIVE_CONFIRM=agent_disposable_<unique_run_id_at_least_8_chars>.hotels
